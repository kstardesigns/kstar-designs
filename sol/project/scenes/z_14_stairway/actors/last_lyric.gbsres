    {
      "command": "EVENT_IF_FLAGS_COMPARE",
      "args": {
        "variable": "70",
        "flag": 5,
        "__collapseElse": true
      },
      "children": {
        "true": [
          {
            "command": "EVENT_TEXT",
            "args": {
              "text": [
                "She's the one who's \nbeen writing these  @",
                "lyrics everywhere! \nShe just wrote  @",
                "another here:\n@",
                "!F:d6f5a3ee-a2ad-4345-9b89-cff6108d7680!Earth calling, \npilot to co-pilot  \n@",
                "!F:d6f5a3ee-a2ad-4345-9b89-cff6108d7680!Looking for life on this \nplanet, sir, no sign \nof it  @",
                "!F:d6f5a3ee-a2ad-4345-9b89-cff6108d7680!All I can see is a bunch \nof smoke flyin'  \n@",
                "!F:d6f5a3ee-a2ad-4345-9b89-cff6108d7680!And I'm so high that I \nmight die if I go by\nit  @",
                "!F:d6f5a3ee-a2ad-4345-9b89-cff6108d7680!Let me outta this \nplace, I'm outta\nplace  @",
                "!F:d6f5a3ee-a2ad-4345-9b89-cff6108d7680!I'm in outer space, \nI've just vanished \nwithout a trace  @",
                "!F:d6f5a3ee-a2ad-4345-9b89-cff6108d7680!I'm going to a pretty \nplace now where the \nflowers grow  @",
                "!F:d6f5a3ee-a2ad-4345-9b89-cff6108d7680!I'll be back in an hour \nor so"
              ],
              "__section": "text",
              "avatarId": "",
              "minHeight": 3,
              "maxHeight": 7,
              "textX": 1,
              "textY": 1,
