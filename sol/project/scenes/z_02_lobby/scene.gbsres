                          "closeDelayFrames": 30,
                          "__collapse": true
                        },
                        "id": "4f189b65-1216-429f-a419-fd3a57422067"
                      },
                      {
                        "command": "EVENT_TEXT",
                        "args": {
                          "text": [
                            " What? Except what?"
                          ],
                          "__section": "text",
                          "avatarId": "15bf858a-832a-4bbf-b3ab-db054b0b3ce1",
                          "minHeight": 4,
                          "maxHeight": 7,
                          "textX": 1,
                          "textY": 1,
                          "textHeight": 5,
                          "position": "bottom",
                          "clearPrevious": true,
                          "showFrame": "true",
                          "speedIn": -1,
                          "speedOut": -1,
                          "closeWhen": "key",
                          "closeButton": "a",
                          "closeDelayTime": 0.5,
                          "closeDelayFrames": 30,
                          "__collapse": true
                        },
                        "id": "e9fdd49a-0e80-4b7d-a39f-692b5b31a781"
                      },
                      {
                        "command": "EVENT_TEXT",
                        "args": {
                          "text": [
                            " The internet is out.\n Which isn't a  @",
                            " huge deal in itself.\n But, uh...  @ ",
                            " Unfortunately we\n are locked in  @",
                            " due to the smart\n lock on the main  @",
                            " door..."
                          ],
                          "__section": "text",
                          "avatarId": "54c7ec7c-329e-4d92-8204-26cfc73f97cd",
                          "minHeight": 4,
                          "maxHeight": 7,
                          "textX": 1,
                          "textY": 1,
                          "textHeight": 5,
                          "position": "bottom",
                          "clearPrevious": true,
                          "showFrame": "true",
                          "speedIn": -1,
                          "speedOut": -1,
                          "closeWhen": "key",
                          "closeButton": "a",
                          "closeDelayTime": 0.5,
                          "closeDelayFrames": 30,
                          "__collapse": true
                        },
                        "id": "a2c37f6b-6bab-4fe5-9bad-af2361579245"
                      },
                      {
                        "command": "EVENT_TEXT",
                        "args": {
                          "text": [
                            " Are you serious? \n Whose awful  @",
                            " idea was that?"
                          ],
                          "__section": "text",
                          "avatarId": "d25bd1b7-c8c3-4c01-812a-cb2ee3f1ca0c",
                          "minHeight": 4,
                          "maxHeight": 7,
                          "textX": 1,
                          "textY": 1,
                          "textHeight": 5,
                          "position": "bottom",
                          "clearPrevious": true,
                          "showFrame": "true",
                          "speedIn": -1,
                          "speedOut": -1,
                          "closeWhen": "key",
                          "closeButton": "a",
                          "closeDelayTime": 0.5,
                          "closeDelayFrames": 30,
                          "__collapse": true
                        },
                        "id": "1b04bca5-77a5-451e-819c-cb538c4961a9"
                      },
                      {
                        "command": "EVENT_TEXT",
                        "args": {
                          "text": [
                            " Our daughter is\n missing! The  @",
                            " problems keep\n piling up. What a  @",
                            " mess this trip has\n become."
                          ],
                          "__section": "text",
                          "avatarId": "1e98a94e-e461-48df-b792-89ca96f413cc",
                          "minHeight": 4,
                          "maxHeight": 7,
                          "textX": 1,
                          "textY": 1,
                          "textHeight": 5,
                          "position": "bottom",
                          "clearPrevious": true,
                          "showFrame": "true",
                          "speedIn": -1,
                          "speedOut": -1,
                          "closeWhen": "key",
                          "closeButton": "a",
                          "closeDelayTime": 0.5,
                          "closeDelayFrames": 30,
                          "__collapse": true
                        },
                        "id": "85a53a14-9f4b-4243-b99e-cb9364e4f03e"
                      },
                      {
                        "command": "EVENT_TEXT",
                        "args": {
                          "text": [
                            " All the exhibits\n are still open... @",
                            " So please distract\n yourselves while  @",
                            " we get this inter-\n net situation  @",
                            " sorted out.  @",
                            " Actually... there\n is a way to  @",
                            " manually unlock \n the front door.  @",
                            " Each employee is \n supposed to have @",
                            " a key. If we can \n find 4 keys, and  @",
                            " put them all in that\n front door lock,  @",
                            " we can unlock the\n door's fusebox  @",
                            " and turn it back\n on."
                          ],
                          "__section": "text",
                          "avatarId": "54c7ec7c-329e-4d92-8204-26cfc73f97cd",
                          "minHeight": 4,
                          "maxHeight": 7,
