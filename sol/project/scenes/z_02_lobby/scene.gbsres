                      },
                      {
                        "command": "EVENT_TEXT",
                        "args": {
                          "text": [
                            " Okay, everyone, it\n looks like the  @",
                            " back-up generator\n is working. There  @",
                            " is no need to worry.\n Except..."
                          ],
                          "__section": "text",
                          "avatarId": "54c7ec7c-329e-4d92-8204-26cfc73f97cd",
                          "minHeight": 4,
                          "maxHeight": 7,
