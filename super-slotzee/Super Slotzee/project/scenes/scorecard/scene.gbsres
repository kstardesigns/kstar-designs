    {
      "command": "EVENT_COMMENT",
      "args": {
        "text": "Set starting position of pencil to 1's box, if not scored this turn and not on turn 1 / roll 1 (dice1result of 0). ALso checking if dice 1 is wild since we are using 0 for wild",
        "__collapse": true
      },
      "id": "dd28becd-753b-4119-a09f-ae84271be65c"
    },
