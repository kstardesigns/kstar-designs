                                }
                              },
                              "id": "4cf84363-1ca6-4a62-a129-50c600d3494f"
                            }
                          ],
                          "false": [
                            {
                              "command": "EVENT_COMMENT",
                              "args": {
                                "text": "For tracking 2 wilds with full house:\nIf there's exactly 1 pair, then the 2 wilds can match the 1 unknown to form a full house"
                              },
                              "id": "e02ee75b-9acf-498e-a612-0642a5e7d196"
                            },
                            {
                              "command": "EVENT_IF",
                              "args": {
                                "condition": {
