                      }
                    ],
                    "false": [
                      {
                        "command": "EVENT_COMMENT",
                        "args": {
                          "text": "For tracking 1 wild with full house:\nif there are exactly 2 pairs (+ the wild), it's a full house\nif 4oak_boolean is true & yotzee is false, that means there are 3 matching numbers + wild card. \nThe wild card then pairs with the 5th other die, making a full house"
                        },
                        "id": "736510a2-20bb-4b4a-ae2d-326cd9d1e33d"
                      },
                      {
                        "command": "EVENT_IF",
                        "args": {
                          "condition": {
                            "type": "expression",
                            "value": "$151$ == 1 && ($27$ == 2 || ($30$ && !$39$))"
                          },
                          "__collapseElse": false
                        },
                        "children": {
                          "true": [
                            {
                              "command": "EVENT_SET_VALUE",
