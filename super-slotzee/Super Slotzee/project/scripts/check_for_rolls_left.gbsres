  "_resourceType": "script",
  "id": "9963b3b8-a749-42c6-99c7-850bc91418a7",
  "name": "Check for rolls left",
  "description": "This reminds the player they have turns left if they are trying to score early on turns 1 or 2 (they can still score early)",
  "variables": {},
  "actors": {},
  "symbol": "script_25",
  "script": [
    {
      "command": "EVENT_IF",
      "args": {
        "condition": {
          "type": "variable",
          "value": "300"
        },
        "__collapseElse": true
      },
      "children": {
        "true": [
          {
            "command": "EVENT_IF",
            "args": {
              "condition": {
                "type": "expression",
                "value": "($16$ < 4 && $61$) || ($16$ < 3 && !$61$)"
              },
              "__collapseElse": true,
              "__collapse": false
            },
            "children": {
              "true": [
                {
                  "command": "EVENT_IF",
